---
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import CtaBand from '../components/CtaBand.astro';
import IndustryIcon from '../components/IndustryIcon.astro';
import SystemPreview from '../components/SystemPreview.astro';
import { industries, operatingPrinciples, services, site } from '../data/site';

const process = [
  { number: '01', title: 'Understand', copy: 'We learn your order profile, requirements, systems, and non-negotiables before proposing a workflow.' },
  { number: '02', title: 'Design', copy: 'Together, we define the receiving, inventory, fulfillment, shipping, and exception-handling process.' },
  { number: '03', title: 'Validate', copy: 'We test the details, clarify ownership, and establish what success should look like before launch.' },
  { number: '04', title: 'Operate', copy: 'Your work runs through a repeatable process with responsive people close to the operation.' },
];

const topBenefits = [
  {
    title: 'Built around your operation.',
    copy: 'Products, order profiles, packaging, systems, and exception rules shape the workflow—not a generic template.',
  },
  {
    title: 'Visibility without the black box.',
    copy: 'Clear status, defined ownership, and useful communication help your team understand what is happening and what needs attention.',
  },
  {
    title: 'People close enough to act.',
    copy: 'Questions and exceptions stay connected to people who understand the work and can move the issue forward.',
  },
];

const integrationCandidates = [
  { name: 'Shopify', mark: 'S' },
  { name: 'WooCommerce', mark: 'W' },
  { name: 'Amazon', mark: 'A' },
  { name: 'Walmart', mark: 'W' },
  { name: 'eBay', mark: 'e' },
  { name: 'BigCommerce', mark: 'B' },
  { name: 'TikTok Shop', mark: 'T' },
  { name: 'Custom / API', mark: '{ }' },
];
---

<SiteLayout title={site.name}>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__headline">
        <p class="eyebrow eyebrow--light">Fulfillment for experienced operators</p>
        <h1>When the details matter, <em>your partner matters.</em></h1>
      </div>
      <div class="hero__intro">
        <p>Dependable fulfillment for established brands that value accuracy, clear communication, and an operating partner who stays accountable.</p>
        <div class="hero__actions">
          <a class="button" href="/contact/">Get a quote</a>
          <a class="button button--outline" href="/how-it-works/">See how we work</a>
        </div>
      </div>
      <div class="hero__proof" aria-label="Xpert Fulfillment highlights">
        <div><strong>100K</strong><span>square-foot primary facility</span></div>
        <div><strong>Hands-on</strong><span>service close to the operation</span></div>
        <div><strong>Built to fit</strong><span>processes shaped around the work</span></div>
      </div>
    </div>
  </section>

  <div class="statement-strip">
    <div class="container statement-strip__inner">
      <p>Big enough to handle the work. Personal enough to care how it gets done.</p>
      <span>Xpert Fulfillment</span>
    </div>
  </div>

  <section class="section section--proof-intro">
    <div class="container proof-intro">
      <div class="proof-intro__copy">
        <p class="eyebrow">Control where it counts</p>
        <h2>Fulfillment should create confidence, not more chasing.</h2>
        <div class="benefit-list">
          {topBenefits.map((benefit) => (
            <article class="benefit-list__item">
              <span aria-hidden="true">✓</span>
              <div><h3>{benefit.title}</h3><p>{benefit.copy}</p></div>
            </article>
          ))}
        </div>
        <a class="button" href="/contact/">Get a quote</a>
      </div>

      <div class="proof-intro__visual">
        <div class="review-proof review-proof--pending">
          <span class="review-proof__icon" aria-hidden="true">S</span>
          <div>
            <div class="review-proof__stars" aria-label="Rating placeholder">☆ ☆ ☆ ☆ ☆</div>
            <strong>Verified review signal</strong>
            <small>Shopify/App Store source, score, and review count pending confirmation.</small>
          </div>
        </div>
        <SystemPreview />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Fulfillment without the runaround"
        title="Operational discipline, with real people behind it."
        copy="You do not need another black-box vendor. You need a team that understands the work, communicates clearly, and takes ownership when something needs attention."
      />
      <div class="service-grid">
        {services.map((service) => (
          <article class="service-card">
            <span class="service-card__number">{service.number}</span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </article>
        ))}
      </div>
      <p style="margin-top: 34px;"><a class="text-link" href="/services/">Explore our capabilities <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="section section--connections" id="integrations">
    <div class="container">
      <SectionHeading
        eyebrow="Commerce connections"
        title="Bring orders together. Keep the operation connected."
        copy="The final site will show every currently supported shopping cart, marketplace, and approved connection after the integration inventory is verified with Bob."
      />
      <div class="integration-grid" aria-label="Candidate integrations pending verification">
        {integrationCandidates.map((integration) => (
          <article class="integration-card">
            <span class="integration-card__mark" aria-hidden="true">{integration.mark}</span>
            <div><strong>{integration.name}</strong><small>Confirm support</small></div>
          </article>
        ))}
      </div>
      <p class="approval-note"><strong>Preview note:</strong> these are candidate platforms for layout review, not published integration claims. Unsupported items will be removed and verified connections added before launch.</p>
    </div>
  </section>

  <section class="section section--industries">
    <div class="container">
      <SectionHeading
        eyebrow="Industries served"
        title="Experience across products that demand attention to detail."
        copy="The category may change. The need for controlled inventory, accurate orders, and accountable execution does not."
      />
      <div class="industry-card-grid">
        {industries.map((industry) => (
          <article class="industry-card">
            <div class="industry-card__icon"><IndustryIcon name={industry.icon} /></div>
            <h3>{industry.title}</h3>
            <p>{industry.description}</p>
          </article>
        ))}
      </div>
      <p class="section-link"><a class="text-link" href="/industries/">Explore industries served <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container split-grid">
      <PhotoPlaceholder label="Facility photography" note="Replace with an approved wide warehouse or active operations image" />
      <div class="split-copy">
        <p class="eyebrow">Built for teams who know the difference</p>
        <h2>Your operation should feel controlled—not mysterious.</h2>
        <p>Experienced operators notice the handoffs, the exceptions, and the small details that become expensive when nobody owns them. We build the working relationship around those realities.</p>
        <ul class="check-list">
          {operatingPrinciples.map((principle) => <li>{principle}</li>)}
        </ul>
        <a class="text-link" href="/about/">Why Xpert <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section--forest">
    <div class="container">
      <p class="eyebrow eyebrow--light">A deliberate path to launch</p>
      <h2 style="max-width: 850px;">We understand first. Then we design the operation.</h2>
      <div class="process-grid">
        {process.map((step) => (
          <article class="process-step">
            <span>{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-grid split-grid--reverse">
      <PhotoPlaceholder label="Team photography" note="Replace with Seth, Bob, Ray, or an operations team image" variant="team" />
      <div class="split-copy">
        <p class="eyebrow">Close to the work</p>
        <h2>The people answering you should understand your operation.</h2>
        <p>Xpert is built around responsive, hands-on service. That means fewer layers between your question and the people who can find the answer—and a partner who treats communication as part of fulfillment, not an add-on.</p>
        <p>From onboarding through day-to-day exceptions, the goal is the same: clear ownership, useful answers, and fewer surprises for your team.</p>
        <a class="text-link" href="/how-it-works/">See our approach <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section testimonial-section" id="client-proof">
    <div class="container testimonial-layout">
      <div>
        <p class="eyebrow eyebrow--light">Client perspective</p>
        <h2>The strongest proof comes from the people living the operation.</h2>
        <p>Approved client stories will show what changed, how the relationship works, and why the result mattered—not just offer a line of generic praise.</p>
      </div>
      <article class="testimonial-placeholder">
        <span>Customer testimonial placeholder</span>
        <h3>Approved client quote will appear here.</h3>
        <p>Pair with a customer name, role, company, photo or logo, and a verified operating result after publication permission is confirmed.</p>
        <footer>
          <i aria-hidden="true"></i>
          <div><strong>Client name and role</strong><small>Company • pending approval</small></div>
        </footer>
      </article>
    </div>
  </section>

  <CtaBand />
</SiteLayout>
