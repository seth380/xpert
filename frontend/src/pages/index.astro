---
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import CtaBand from '../components/CtaBand.astro';
import { operatingPrinciples, services, site } from '../data/site';

const process = [
  { number: '01', title: 'Understand', copy: 'We learn your order profile, requirements, systems, and non-negotiables before proposing a workflow.' },
  { number: '02', title: 'Design', copy: 'Together, we define the receiving, inventory, fulfillment, shipping, and exception-handling process.' },
  { number: '03', title: 'Validate', copy: 'We test the details, clarify ownership, and establish what success should look like before launch.' },
  { number: '04', title: 'Operate', copy: 'Your work runs through a repeatable process with responsive people close to the operation.' },
];
---

<SiteLayout title={site.name}>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__headline">
        <p class="eyebrow eyebrow--light">Fulfillment for experienced operators</p>
        <h1>When the details matter, <em>your partner matters.</em></h1>
      </div>
      <div class="hero__intro">
        <p>Dependable fulfillment for established brands that value accuracy, clear communication, and an operating partner who stays accountable.</p>
        <div class="hero__actions">
          <a class="button" href="/contact/">Start a conversation</a>
          <a class="button button--outline" href="/how-it-works/">See how we work</a>
        </div>
      </div>
      <div class="hero__proof" aria-label="Xpert Fulfillment highlights">
        <div><strong>100K</strong><span>square-foot primary facility</span></div>
        <div><strong>Hands-on</strong><span>service close to the operation</span></div>
        <div><strong>Built to fit</strong><span>processes shaped around the work</span></div>
      </div>
    </div>
  </section>

  <div class="statement-strip">
    <div class="container statement-strip__inner">
      <p>Big enough to handle the work. Personal enough to care how it gets done.</p>
      <span>Xpert Fulfillment</span>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Fulfillment without the runaround"
        title="Operational discipline, with real people behind it."
        copy="You do not need another black-box vendor. You need a team that understands the work, communicates clearly, and takes ownership when something needs attention."
      />
      <div class="service-grid">
        {services.map((service) => (
          <article class="service-card">
            <span class="service-card__number">{service.number}</span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </article>
        ))}
      </div>
      <p style="margin-top: 34px;"><a class="text-link" href="/services/">Explore our capabilities <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container split-grid">
      <PhotoPlaceholder label="Facility photography" note="Replace with an approved wide warehouse or active operations image" />
      <div class="split-copy">
        <p class="eyebrow">Built for teams who know the difference</p>
        <h2>Your operation should feel controlled—not mysterious.</h2>
        <p>Experienced operators notice the handoffs, the exceptions, and the small details that become expensive when nobody owns them. We build the working relationship around those realities.</p>
        <ul class="check-list">
          {operatingPrinciples.map((principle) => <li>{principle}</li>)}
        </ul>
        <a class="text-link" href="/about/">Why Xpert <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section--forest">
    <div class="container">
      <p class="eyebrow eyebrow--light">A deliberate path to launch</p>
      <h2 style="max-width: 850px;">We understand first. Then we design the operation.</h2>
      <div class="process-grid">
        {process.map((step) => (
          <article class="process-step">
            <span>{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-grid split-grid--reverse">
      <PhotoPlaceholder label="Team photography" note="Replace with Seth, Bob, Ray, or an operations team image" variant="team" />
      <div class="split-copy">
        <p class="eyebrow">Close to the work</p>
        <h2>The people answering you should understand your operation.</h2>
        <p>Xpert is built around responsive, hands-on service. That means fewer layers between your question and the people who can find the answer—and a partner who treats communication as part of fulfillment, not an add-on.</p>
        <a class="text-link" href="/how-it-works/">See our approach <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="quote-block">
    <div class="container">
      <blockquote>“A dependable fulfillment partner should make your operation feel more controlled—not less visible.”</blockquote>
      <footer>Xpert operating principle — draft copy for approval</footer>
    </div>
  </section>

  <CtaBand />
</SiteLayout>
