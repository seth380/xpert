---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Page Not Found">
  <section class="not-found">
    <div class="container">
      <h1>404</h1>
      <h2>This page is not in the workflow.</h2>
      <p>The address may have changed or the page may still be under construction.</p>
      <a class="button" href="/">Return home</a>
    </div>
  </section>
</SiteLayout>
