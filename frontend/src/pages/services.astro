---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/site';

const capabilities = [
  { icon: '01', title: 'Receiving', copy: 'Documented intake and handling designed to surface discrepancies instead of burying them.' },
  { icon: '02', title: 'Pick and pack', copy: 'Repeatable fulfillment processes shaped around product, packaging, and order requirements.' },
  { icon: '03', title: 'Kitting and inserts', copy: 'Controlled assembly and presentation work for launches, campaigns, and recurring programs.' },
  { icon: '04', title: 'Labeling', copy: 'Product and shipment labeling performed against agreed specifications and workflows.' },
  { icon: '05', title: 'Shipping', copy: 'Carrier and service coordination with attention to cost, timing, and order-specific needs.' },
  { icon: '06', title: 'Exception support', copy: 'Responsive investigation when an order, address, item, or shipment needs human attention.' },
];

const programInputs = [
  { icon: '01', title: 'Order profile', copy: 'Order volume, SKU count, item mix, seasonality, promotions, bundles, and sales channels all shape the right workflow.' },
  { icon: '02', title: 'Brand requirements', copy: 'Packaging, presentation, inserts, labeling, lot or serial details, and customer experience standards become operating requirements.' },
  { icon: '03', title: 'Service expectations', copy: 'Cutoffs, shipping methods, reporting, communication, approvals, and escalation paths need clear ownership before launch.' },
];

const fitSignals = [
  'You value dependable execution more than a generic rate-card relationship',
  'Your products or orders require documented handling and attention to detail',
  'Your team wants direct communication when exceptions need a decision',
  'You are willing to define requirements clearly before the operation launches',
];
---

<SiteLayout title="Fulfillment Services" description="Order fulfillment, inventory operations, shipping coordination, kitting, labeling, and brand-specific handling from Xpert Fulfillment.">
  <PageHero eyebrow="Services" title="The work behind dependable fulfillment." copy="Core fulfillment capabilities matter. The way they are operated, communicated, and adapted to your requirements matters even more." />

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Core operation" title="From receiving through shipment." copy="These capabilities form the operating foundation. Specific service levels, systems, volumes, and commitments are defined around each program during discovery and solution design." />
      <div class="service-grid">
        {services.map((service) => (
          <article class="service-card">
            <span class="service-card__number">{service.number}</span>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <SectionHeading eyebrow="Capabilities" title="Built around the actual work." copy="Each workflow is documented around the product, order, presentation, shipping, and exception requirements that make the program distinct." />
      <div class="feature-list">
        {capabilities.map((item) => (
          <article class="feature-card">
            <span class="feature-card__icon">{item.icon}</span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Program design" title="The right operation starts with the right inputs." copy="A fulfillment program is more than a list of services. We look at the variables that affect accuracy, labor, communication, and the experience your customer ultimately receives." />
      <div class="feature-list">
        {programInputs.map((item) => (
          <article class="feature-card">
            <span class="feature-card__icon">{item.icon}</span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container split-grid">
      <div class="split-copy">
        <p class="eyebrow">A strong operating fit</p>
        <h2>Built for brands that care how the work gets done.</h2>
        <p>We are most useful when fulfillment is an important part of the customer promise and both teams want a relationship built on clarity, preparation, and accountability.</p>
      </div>
      <ul class="check-list">
        {fitSignals.map((signal) => <li>{signal}</li>)}
      </ul>
    </div>
  </section>
  <CtaBand title="Bring us the complicated parts." copy="A useful conversation starts with your operating requirements, recurring friction, and what your current fulfillment model is not solving." />
</SiteLayout>
