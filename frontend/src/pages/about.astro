---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import CtaBand from '../components/CtaBand.astro';

const values = [
  { icon: '01', title: 'Reliability', copy: 'Build repeatable processes and honor the commitments we make.' },
  { icon: '02', title: 'Responsiveness', copy: 'Keep communication close to the people who understand the work.' },
  { icon: '03', title: 'Accountability', copy: 'Make ownership clear, especially when something needs attention.' },
];
---

<SiteLayout title="About Xpert" description="A hands-on fulfillment company focused on dependable operations, responsive communication, and accountable service.">
  <PageHero eyebrow="About Xpert" title="A fulfillment partner should feel like part of the operation." copy="Xpert combines the capacity of a 100,000-square-foot primary facility with the direct, hands-on service established brands expect from a committed operating partner." />

  <section class="section">
    <div class="container split-grid">
      <PhotoPlaceholder label="Facility exterior or wide interior" note="Replace with a current, approved photo of Xpert's primary facility" />
      <div class="split-copy">
        <p class="eyebrow">The Xpert difference</p>
        <h2>Capacity without unnecessary distance.</h2>
        <p>Growth often forces brands to choose between operational capacity and personal accountability. Xpert’s position is different: provide the structure required to do the work reliably while keeping communication direct, practical, and close to the people operating it.</p>
        <p>This first draft intentionally avoids unverified dates, statistics, certifications, and performance claims. Those will be added only after the source material is reviewed.</p>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <div class="feature-list">
        {values.map((item) => (
          <article class="feature-card">
            <span class="feature-card__icon">{item.icon}</span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-grid split-grid--reverse">
      <PhotoPlaceholder label="Leadership and operations team" note="Replace with approved team photography and final names/titles" variant="team" />
      <div class="split-copy">
        <p class="eyebrow">Experienced people</p>
        <h2>Continuity and operating knowledge matter.</h2>
        <p>The strongest version of this story will introduce the people who lead and run Xpert, how long they have been close to the work, and what clients can expect from that experience. Final biographies and role details will be written from approved source material.</p>
      </div>
    </div>
  </section>
  <CtaBand />
</SiteLayout>
