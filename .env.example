# Copy this file to .env and fill in real values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=3000

# CORS: comma-separated origins, or * for all (development only)
CORS_ORIGIN=*

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xpert_fulfillment?schema=public

# Placeholders for future carrier/shipping integrations (see docs/CURRENT_STATE.md).
# Fill in only when those integrations are actually wired up.
# DHL_API_KEY=
# SPEEDX_API_KEY=
