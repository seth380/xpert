# Copy this file to .env and fill in real values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=3000

# CORS: comma-separated origins, or * for all (development only)
CORS_ORIGIN=*

# MySQL connection string used by Prisma.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:root@localhost:3306/xpert_fulfillment

# Placeholders for future carrier/shipping integrations (see docs/CURRENT_STATE.md).
# Fill in only when those integrations are actually wired up.
# DHL_API_KEY=
# SPEEDX_API_KEY=
